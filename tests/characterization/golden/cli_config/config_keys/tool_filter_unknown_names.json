{
  "allow_write_setting": true,
  "config": {
    "tool_filters": {
      "disabled_tools": [
        "AlsoMissingTool"
      ],
      "enabled_categories": [
        "no_such_category"
      ],
      "enabled_tools": [
        "NoSuchTool"
      ]
    }
  },
  "env": {
    "OPENSEARCH_DISABLED_TOOLS": "ListIndexTool",
    "OPENSEARCH_NO_AUTH": "true"
  },
  "logs": [
    {
      "level": "INFO",
      "logger": "root",
      "message": "Connected OpenSearch version: 3.1.0"
    },
    {
      "level": "WARNING",
      "logger": "root",
      "message": "Both config file and environment variables are set. Using config file."
    },
    {
      "level": "WARNING",
      "logger": "root",
      "message": "Category 'no_such_category' not found in tool categories"
    },
    {
      "level": "WARNING",
      "logger": "root",
      "message": "Ignoring invalid tool from 'enabled_tools': 'NoSuchTool'"
    },
    {
      "level": "WARNING",
      "logger": "root",
      "message": "Ignoring invalid tool from 'disabled_tools': 'AlsoMissingTool'"
    },
    {
      "level": "INFO",
      "logger": "root",
      "message": "Applied tool filter from <TMP>/config.yml"
    },
    {
      "level": "INFO",
      "logger": "root",
      "message": "Enabled tools: ['ListIndexTool', 'IndexMappingTool', 'SearchIndexTool', 'GetShardsTool', 'GenericOpenSearchApiTool', 'ClusterHealthTool', 'CountTool', 'ExplainTool', 'MsearchTool']"
    }
  ],
  "tool_names": [
    "ListIndexTool",
    "IndexMappingTool",
    "SearchIndexTool",
    "GetShardsTool",
    "GenericOpenSearchApiTool",
    "ClusterHealthTool",
    "CountTool",
    "ExplainTool",
    "MsearchTool"
  ]
}
