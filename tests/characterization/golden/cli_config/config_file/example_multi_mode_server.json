    {
      "description": "This is a custom description for the tool that lists indices. It's much more descriptive now!",
      "inputSchema": {
        "description": "Arguments for the ListIndicesTool.",
        "properties": {
          "include_detail": {
            "default": true,
            "description": "Whether to include detailed information. If False, returns only index name(s). If True, returns full metadata.",
            "title": "Include Detail",
            "type": "boolean"
          },
          "index": {
            "default": "",
            "description": "Custom description for the 'index' argument in ListIndexTool.",
            "title": "Index",
            "type": "string"
          },
          "opensearch_cluster_name": {
            "description": "The name of the OpenSearch cluster",
            "title": "Opensearch Cluster Name",
            "type": "string"
          }
        },
        "required": [
          "opensearch_cluster_name"
        ],
        "title": "ListIndicesArgs",
        "type": "object"
      },
      "name": "My_Custom_Index_Lister"
    },
    {
      "description": "Searches an index using a query written in query domain-specific language (DSL) in OpenSearch. PREREQUISITE: You need to know the mappings of the index before constructing queries.",
      "inputSchema": {
        "description": "Arguments for the SearchIndexTool.",
        "properties": {
          "format": {
            "default": "json",
            "description": "Output format: \"json\" or \"csv\"",
            "title": "Format",
            "type": "string"
          },
          "index": {
            "description": "Custom description for the 'index' argument in SearchIndexTool.",
            "title": "Index",
            "type": "string"
          },
          "opensearch_cluster_name": {
            "description": "The name of the OpenSearch cluster",
            "title": "Opensearch Cluster Name",
            "type": "string"
          },
          "query_dsl": {
            "description": "Explain what kind of query DSL JSON is expected here.",
            "title": "Query Dsl"
          },
          "size": {
            "default": 10,
            "description": "Number of search results to return. The maximum allowed value is 100, unless overridden by configuration.",
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "index",
          "opensearch_cluster_name",
          "query_dsl"
        ],
        "title": "SearchIndexArgs",
        "type": "object"
      },
      "name": "Super_Searcher"
    },
    {
      "description": "A better description to get information about shards in OpenSearch.",
      "inputSchema": {
